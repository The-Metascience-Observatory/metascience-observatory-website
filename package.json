  "scripts": {
    "predev": "bash scripts/dropbox-ignore.sh",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev",
    "dev:safe": "bash scripts/with-dropbox-paused.sh npm run dev",
    "prebuild": "bash scripts/dropbox-ignore.sh && node scripts/check-tool-catalog.mjs",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' next build",
